<?xml version="1.0" encoding="utf-8"?>
<!-- Хранилище зашифровано ключом Android Keystore и не переносится системными бэкапами.
     Для переноса на другое устройство используйте экспорт внутри приложения. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
